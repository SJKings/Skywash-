# Copy to .env (local) — on Vercel set these in Project → Settings → Environment Variables.

# Neon / Vercel Postgres. Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Optional: direct (non-pooled) connection, preferred by `prisma migrate`. Vercel's Neon integration sets it.
DATABASE_URL_UNPOOLED=""

# Password for the admin dashboard and admin API routes. Use a long random value.
ADMIN_PASSWORD=""

# Extra browser origins allowed to call /api/* (comma-separated). The native app needs none.
# http://localhost:8081 (Expo web) is always allowed outside production.
CORS_ALLOWED_ORIGINS=""
