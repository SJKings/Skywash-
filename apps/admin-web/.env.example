# Copy to .env (local) — on Vercel set these in Project → Settings → Environment Variables.

# Postgres connection string (Prisma Postgres via Vercel: Storage → Prisma Postgres).
# If unset, DATABASE_POSTGRES_URL is used instead — the name Vercel's integration
# creates when connected with the "DATABASE" prefix.
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
# Optional: separate direct connection for the Prisma CLI, if your provider gives one.
DATABASE_URL_UNPOOLED=""

# Password for the admin dashboard and admin API routes. Use a long random value.
ADMIN_PASSWORD=""

# Extra browser origins allowed to call /api/* (comma-separated). The native app needs none.
# http://localhost:8081 (Expo web) is always allowed outside production.
CORS_ALLOWED_ORIGINS=""
