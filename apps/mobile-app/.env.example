# Base URL of the admin-web server (Next.js API routes).
# - iOS simulator / Expo web: http://localhost:3000
# - Android emulator:         http://10.0.2.2:3000
# - Physical device:          http://<your-computer-LAN-IP>:3000, or the deployed Vercel URL
#   (the deployed site only works from the app once Vercel Authentication is off for production)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Public website (apps/website), used for the in-app privacy policy link.
# Store builds set it in eas.json. Locally: http://localhost:3001 if you run the website on 3001.
EXPO_PUBLIC_WEBSITE_URL=
