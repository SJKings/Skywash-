{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://skywash-admin-web.vercel.app",
        "EXPO_PUBLIC_WEBSITE_URL": "https://skywash-ng.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://skywash-admin-web.vercel.app",
        "EXPO_PUBLIC_WEBSITE_URL": "https://skywash-ng.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
